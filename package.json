{
  "name": "omp-notify-feishu",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "settings": {
      "webhookUrl": {
        "type": "string",
        "description": "飞书自定义机器人 Webhook 地址",
        "secret": true
      },
      "signingSecret": {
        "type": "string",
        "description": "飞书自定义机器人签名密钥",
        "secret": true
      },
      "keyword": {
        "type": "string",
        "description": "通知首行关键词，可用于飞书关键词安全校验",
        "default": "AI通知"
      },
      "timeoutMs": {
        "type": "number",
        "description": "通知请求超时毫秒数",
        "default": 5000,
        "min": 1,
        "max": 30000
      }
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.3.4",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
